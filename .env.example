# ==========================================
# RoomTherapy Backend 환경 변수 템플릿 (.env.example)
# 복사하여 .env 파일로 생성 후 사용하세요: cp .env.example .env
# ==========================================

# 프로파일 활성화 (local / prod)
# SPRING_PROFILES_ACTIVE=prod

# ==========================================
# 1. Database (MySQL - 운영 환경)
# ==========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=roomtherapy
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
# 또는 Full JDBC URL 직접 지정 시:
# MYSQL_URL=jdbc:mysql://localhost:3306/roomtherapy?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul

# ==========================================
# 2. Redis
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# 3. Kakao OAuth2
# ==========================================
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# ==========================================
# 4. JWT & Security
# ==========================================
# 최소 256비트(32바이트 이상) Base64 인코딩 비밀키
JWT_SECRET=your_base64_encoded_jwt_secret_key_minimum_256_bits
COOKIE_SECURE=false

# ==========================================
# 5. 관리자 및 판매자 지정 (카카오 ID 목록, 쉼표 구분)
# ==========================================
ADMIN_KAKAO_IDS=
SELLER_KAKAO_IDS=
